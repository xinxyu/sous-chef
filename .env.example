# Copy to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection (required for saving recipes)
DATABASE_URL=postgresql://user:password@localhost:5432/sous_chef

# Optional: set a secret for session signing (change in production)
# SECRET_KEY=your-secret-key-here

# When frontend is on another domain (e.g. Vercel), set its URL so CORS allows it (comma-separated for multiple).
# For mobile testing on the same network, add your machine's URL, e.g. http://192.168.1.5:4200
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Set to 1 or true only when frontend and API are served over HTTPS. Leave unset for local/mobile HTTP
# so the session cookie can be stored (otherwise you get "Authentication required" after login on mobile).
# SESSION_COOKIE_SECURE=1

# Base URL for verification and password-reset links (defaults to FRONTEND_ORIGIN or http://localhost:4200)
# APP_BASE_URL=https://your-app.vercel.app

# Resend (https://resend.com) for verification and password-reset emails
# RESEND_API_KEY=re_xxxxxxxxxxxx
# FROM_EMAIL=Sous Chef <onboarding@resend.dev>   # or your verified domain, e.g. noreply@yourdomain.com
